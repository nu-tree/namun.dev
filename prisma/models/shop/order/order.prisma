/*
  INFO 주문 table
  정산과 연결되는 table이라 주요 정보를 모두 가지고 있어야함
  상품, 옵션, 배송지 등 주문 이후에 바뀔 수 있으니까

  INFO 주문번호 예시: 20240101-000001-001
  - 20240101: 주문 날짜
  - 000001: 주문 번호
  - 001: 주문 상품 순서
*/

enum OrderStatus {
  PAYMENT_DONE         // 결제 완료
  ORDER_CONFIRMED      // 관리자 주문 확정
  IN_DELIVERY          // 배송중 (송장번호 입력됨)
  ORDER_DELIVERED      // 배송 완료
  CANCELLED            // 전체 취소
  PARTIALLY_CANCELLED  // 부분 취소
  REFUNDED             // 환불 완료
}

model Order {
  id            String @id @default(cuid()) @map("id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  orderStatus   OrderStatus @map("order_status") // 주문 상태

  orderNumber   String @map("order_number") // 주문번호(유니크), 20240101-000001-001
  orderAmount   Int @map("order_amount") // 주문 금액
  orderName     String @map("order_name") // 주문명 사과1개 외 2건
  orderTime     DateTime @map("order_time") // 주문(결제)완료 시간

  // INFO 이정보는 payment(시스템에 따라서 필요없을수도 있음)정보에 있는가?
  paymentMethod String @map("payment_method") // 결제 방법 카드, 계좌이체, 무통장입금, 휴대폰결제, 지역상품권, 무통장입금, 휴대폰결제, 지역상품권
  totalPrice    Int @map("total_price") // 총 결제 금액

  isSettle      Boolean @default(false) @map("is_settle") // 정산 완료 여부

  note          String? @map("note") // 주문 노트

  // INFO: 관계 1:N (주문 상품)
  orderProducts OrderProduct[] @relation("order_product")

  // INFO: 관계 1:N (주문 이력)
  orderHistories OrderHistory[] @relation("order_history")

  // INFO: 관계 1:N (주문 쿠폰)
  orderCoupons OrderCoupon[] @relation("order_coupon")

  // INFO: 관계 1:1 (주문 결제)
  // orderPayment OrderPayment? @relation("order_payment")

  @@unique([orderNumber])
  @@map("order")
}