enum PopupDisplayType {
  PC
  MOBILE
  ALL
}

enum PopupPositionType {
  TOP_LEFT
  TOP_CENTER
  TOP_RIGHT
  CENTER_LEFT
  CENTER
  CENTER_RIGHT
}

enum PopupSizeType {
  SMALL
  MEDIUM
  LARGE
}

model Popup {
  id               String           @id @default(cuid()) @map("id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")
  identifier       String           @unique @map("identifier") // 고유 식별자 ( main-popup 등 )
  content          String           @map("content") // 팝업 이미지 URL
  linkUrl          String?          @map("link_url") // 선택적: 팝업 클릭 시 이동할 URL
  displayOrder     Int              @default(0) @map("display_order") // 노출 순서를 위한 값
  startDate        DateTime         @map("start_date") // 팝업 노출 시작일
  endDate          DateTime?         @map("end_date") // 팝업 노출 종료일
  topPosition      Int              @default(0) @map("top_position") // 팝업 노출 위치 (상단 기준)
  leftPosition     Int              @default(0) @map("left_position") // 팝업 노출 위치 (왼쪽 기준)
  width            Int              @default(0) @map("width") // 팝업 가로 사이즈
  height           Int              @default(0) @map("height") // 팝업 세로 사이즈
  displayPages     String?          @map("display_pages") // 팝업을 노출시킬 페이지들 (ex. /,/products,/mypage)
  displayType      PopupDisplayType @map("display_type") // 팝업 노출 방식 종류
  positionType     PopupPositionType @map("position_type") // 팝업 노출 위치 타입
  sizeType         PopupSizeType    @map("size_type") // 팝업 너비 타입

  @@map("popup")
}
