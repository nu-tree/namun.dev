model Comment {
  id        String    @id @default(cuid()) @map("id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  content   String    @map("content") // 댓글 내용
  postId    String    @map("post_id")
  username  String?   @map("username")
  userId    String?   @map("user_id")
  parentId  String?   @map("parent_id")

  post    Post      @relation("comment_post", fields: [postId], references: [id])
  parent  Comment?  @relation("comment_replies", fields: [parentId], references: [id])
  replies Comment[] @relation("comment_replies")

  @@map("comment")
}
